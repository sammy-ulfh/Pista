---
/**
 * EtapasRoadmap — las etapas del roadmap (pantalla 07 · Ciberseguridad).
 *
 * Escritorio: las etapas en fila, unidas por una línea. Móvil: la misma información como línea de tiempo vertical.
 * Cada tarjeta: «Etapa N · Sem X–Y», el nombre, los cursos (cada uno enlaza a su ficha), sus píldoras («Estás aquí»,
 * «Completada», «Opcional», «Solo en laboratorio»), cuántas lecciones llevas y «Al terminar: …».
 * La etapa actual va destacada con la sombra desplazada.
 *
 * Las etapas, su orden y su estado los calcula `lib/roadmap.ts`; aquí solo se dibujan (`<template>` + `vista-ruta.ts`).
 * Los nombres de las etapas y «Al terminar» se editan en `datos/escuelas.json` → `etapas` del área.
 *
 *   <EtapasRoadmap />
 */
---

<section aria-labelledby="titulo-etapas" class="mt-8" data-etapas-roadmap>
  <h2 id="titulo-etapas" class="sr-only">Etapas de tu roadmap</h2>
  <ol
    class="relative ml-2 flex flex-col gap-5 border-l-[3px] border-tinta pl-6 lg:ml-0 lg:grid lg:grid-cols-[repeat(var(--columnas,5),minmax(0,1fr))] lg:gap-6 lg:border-l-0 lg:pl-0"
    data-lista
  >
  </ol>

  <template data-plantilla-etapa>
    <li
      class="group relative flex flex-col rounded-cuaderno border-2 border-tinta bg-blanco p-4 before:absolute before:top-5 before:-left-[2.2rem] before:size-4 before:rounded-full before:border-[3px] before:border-tinta before:bg-papel data-[actual]:shadow-desplazada data-[actual]:before:bg-tinta data-[completada]:before:bg-tinta lg:before:hidden lg:[&:not(:last-child)]:after:absolute lg:[&:not(:last-child)]:after:top-1/2 lg:[&:not(:last-child)]:after:-right-[1.65rem] lg:[&:not(:last-child)]:after:w-6 lg:[&:not(:last-child)]:after:border-t-[3px] lg:[&:not(:last-child)]:after:border-tinta"
    >
      <p class="text-sm text-texto-2" data-campo="encabezado"></p>
      <h3 class="mt-0.5 text-xl leading-tight break-words">
        <span data-campo="nombre"></span>
        <span class="sr-only" data-campo="estado-sr"></span>
      </h3>
      <ul class="mt-2 flex flex-col gap-1" data-cursos></ul>
      <p class="mt-3 flex flex-wrap gap-1.5" data-pildoras></p>
      <p class="mt-2 text-sm text-texto-2" data-campo="avance"></p>
      <p class="mt-3 text-sm text-texto-2 lg:mt-auto lg:pt-3"><b class="font-semibold text-tinta">Al terminar:</b> <span data-campo="al-terminar"></span></p>
    </li>
  </template>

  <template data-plantilla-curso>
    <li class="leading-snug">
      <a class="inline-flex min-h-8 items-center break-words underline decoration-linea decoration-2 underline-offset-4 hover:decoration-tinta"></a>
    </li>
  </template>

  <template data-plantilla-pildora>
    <span class="inline-flex min-h-8 items-center rounded-full border-2 px-3 text-sm font-medium whitespace-nowrap"></span>
  </template>
</section>

<script>
  import { pildorasEtapa, textoEncabezadoEtapa } from '../../lib/roadmap';
  import { alTenerRuta, copiarPlantilla, ponerTexto } from './vista-ruta';

  const raiz = document.querySelector<HTMLElement>('[data-etapas-roadmap]');
  const lista = raiz?.querySelector<HTMLOListElement>('[data-lista]');
  const plantilla = raiz?.querySelector<HTMLTemplateElement>('[data-plantilla-etapa]');
  const plantillaCurso = raiz?.querySelector<HTMLTemplateElement>('[data-plantilla-curso]');
  const plantillaPildora = raiz?.querySelector<HTMLTemplateElement>('[data-plantilla-pildora]');

  /** Mismo aspecto que `ui/Pildora.astro`: «Estás aquí» en relleno, «Opcional» suave y el resto con borde de tinta. */
  const ESTILO_PILDORA: Record<string, string> = {
    'Estás aquí': 'border-tinta bg-relleno text-tinta',
    Opcional: 'border-texto-3 bg-blanco text-texto-2',
  };
  const ESTADO_SR = { actual: '(estás aquí)', completada: '(completada)', pendiente: '' } as const;

  if (lista && plantilla && plantillaCurso && plantillaPildora) {
    alTenerRuta((vista) => {
      lista.replaceChildren();
      const roadmap = vista?.roadmap;
      if (!vista || !roadmap) return;
      lista.style.setProperty('--columnas', String(roadmap.etapas.length));

      for (const etapa of roadmap.etapas) {
        const tarjeta = copiarPlantilla(plantilla);
        ponerTexto(tarjeta, 'encabezado', textoEncabezadoEtapa(etapa));
        ponerTexto(tarjeta, 'nombre', etapa.nombre);
        ponerTexto(tarjeta, 'estado-sr', ESTADO_SR[etapa.estado]);
        ponerTexto(tarjeta, 'al-terminar', etapa.alTerminar);
        ponerTexto(
          tarjeta,
          'avance',
          etapa.lecciones.length > 0 && etapa.vistas > 0 ? `${etapa.vistas} de ${etapa.lecciones.length} lecciones vistas` : '',
        );
        if (etapa.estado === 'actual') {
          tarjeta.dataset.actual = '';
          tarjeta.setAttribute('aria-current', 'step');
        }
        if (etapa.estado === 'completada') tarjeta.dataset.completada = '';

        const cursos = tarjeta.querySelector<HTMLElement>('[data-cursos]')!;
        for (const id of etapa.cursos) {
          const fila = copiarPlantilla(plantillaCurso);
          const enlace = fila.querySelector('a')!;
          enlace.href = `/cursos/${id}`;
          enlace.textContent = vista.cursos[id]?.titulo ?? id;
          cursos.append(fila);
        }

        const pildoras = tarjeta.querySelector<HTMLElement>('[data-pildoras]')!;
        for (const texto of pildorasEtapa(etapa)) {
          const pildora = copiarPlantilla(plantillaPildora);
          pildora.className += ` ${ESTILO_PILDORA[texto] ?? 'border-tinta bg-blanco text-tinta'}`;
          pildora.textContent = texto === 'Completada' ? '✓ Completada' : texto;
          pildoras.append(pildora);
        }
        pildoras.hidden = pildoras.childElementCount === 0;
        lista.append(tarjeta);
      }
    });
  }
</script>
