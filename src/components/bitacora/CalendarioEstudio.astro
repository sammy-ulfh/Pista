---
/**
 * CalendarioEstudio — «Días que estudiaste» (pantalla 12): las últimas 3 semanas, de lunes a domingo.
 * Los días de estudio van rellenos de tinta; hoy lleva un contorno; los días que aún no llegan, punteados.
 *
 * Las fechas salen de `calendarioEstudio()` (`lib/bitacora.ts`) con la fecha local del navegador.
 *
 *   <CalendarioEstudio />
 */
const DIAS = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
---

<section aria-labelledby="titulo-calendario" data-calendario>
  <h2 id="titulo-calendario" class="text-2xl">Días que estudiaste</h2>
  <div class="mt-4 max-w-md">
    <div aria-hidden="true" class="grid grid-cols-7 gap-2 text-center text-sm text-texto-2">
      {DIAS.map((dia) => <span>{dia}</span>)}
    </div>
    <ol class="mt-2 grid grid-cols-7 gap-2" data-dias></ol>
  </div>
  <p class="mt-3 flex items-center gap-2 text-sm text-texto-2">
    <span aria-hidden="true" class="inline-block size-4 rounded bg-tinta"></span> = estudiaste ese día
  </p>

  <template data-plantilla-dia>
    <li
      class="flex aspect-square items-center justify-center rounded-lg border-2 border-tinta bg-blanco text-sm data-estudiado:bg-tinta data-estudiado:text-blanco data-futuro:border-dashed data-futuro:border-linea data-futuro:bg-papel data-futuro:text-texto-2 data-hoy:outline-3 data-hoy:outline-offset-2 data-hoy:outline-tinta"
    >
      <span aria-hidden="true" data-campo="dia"></span>
      <span class="sr-only" data-campo="descripcion"></span>
    </li>
  </template>
</section>

<script>
  import { leerFecha } from '../../lib/bitacora';
  import { alTenerBitacora } from './vista-bitacora';

  const raiz = document.querySelector<HTMLElement>('[data-calendario]');
  const lista = raiz?.querySelector<HTMLOListElement>('[data-dias]');
  const plantilla = raiz?.querySelector<HTMLTemplateElement>('[data-plantilla-dia]');
  const formato = new Intl.DateTimeFormat('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

  if (lista && plantilla) {
    alTenerBitacora((vista) => {
      lista.replaceChildren();
      for (const dia of vista.calendario.flat()) {
        const celda = (plantilla.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
        celda.querySelector('[data-campo="dia"]')!.textContent = String(dia.dia);
        const fecha = leerFecha(dia.fecha);
        const estado = dia.estudiado ? 'estudiaste' : dia.futuro ? 'todavía no llega' : 'sin estudio';
        celda.querySelector('[data-campo="descripcion"]')!.textContent = `${fecha ? formato.format(fecha) : dia.fecha}${dia.esHoy ? ' (hoy)' : ''}: ${estado}`;
        celda.toggleAttribute('data-estudiado', dia.estudiado);
        celda.toggleAttribute('data-futuro', dia.futuro);
        celda.toggleAttribute('data-hoy', dia.esHoy);
        lista.append(celda);
      }
    });
  }
</script>
