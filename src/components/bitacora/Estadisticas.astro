---
/**
 * Estadisticas — las tres cifras de «Mi bitácora» (pantalla 12): días de racha, lecciones vistas y semanas de la
 * ruta completadas («1/5»). Se calculan en el navegador (`vista-bitacora.ts` → `lib/bitacora.ts`).
 *
 *   <Estadisticas />
 */
const cifras = [
  { campo: 'racha', etiqueta: 'días de racha' },
  { campo: 'vistas', etiqueta: 'lecciones vistas' },
  { campo: 'semanas', etiqueta: 'semanas de tu ruta' },
];
---

<dl class="grid grid-cols-3 gap-3 sm:gap-5" data-estadisticas>
  {
    cifras.map(({ campo, etiqueta }) => (
      <div class="flex flex-col-reverse rounded-cuaderno border-2 border-tinta bg-blanco px-3 py-4 sm:px-5">
        <dt class="text-sm leading-tight text-texto-2" data-etiqueta={campo}>
          {etiqueta}
        </dt>
        <dd class="font-titulo text-3xl leading-none font-extrabold sm:text-4xl" data-campo={campo}>
          0
        </dd>
      </div>
    ))
  }
</dl>

<script>
  import { alTenerBitacora } from './vista-bitacora';

  const raiz = document.querySelector<HTMLElement>('[data-estadisticas]');
  const poner = (campo: string, texto: string) => {
    const el = raiz?.querySelector<HTMLElement>(`[data-campo="${campo}"]`);
    if (el) el.textContent = texto;
  };

  alTenerBitacora((vista) => {
    poner('racha', String(vista.racha));
    poner('vistas', String(vista.leccionesVistas));
    poner('semanas', vista.semanas ? `${vista.semanas.completadas}/${vista.semanas.total}` : '—');
    const etiqueta = raiz?.querySelector<HTMLElement>('[data-etiqueta="semanas"]');
    if (etiqueta) etiqueta.textContent = vista.semanas ? 'semanas de tu ruta' : 'aún sin ruta';
    const racha = raiz?.querySelector<HTMLElement>('[data-etiqueta="racha"]');
    if (racha) racha.textContent = vista.racha === 1 ? 'día de racha' : 'días de racha';
  });
</script>
