---
/**
 * ListaLecciones — la barra lateral del lector (pantallas 10 y 11).
 *
 * Muestra escuela y área, título del curso, «Lección N de M», la barra de lecciones vistas y la lista de
 * lecciones por módulo con su estado: vista (✓), actual o pendiente. Abajo, «← Volver al curso», que cambia a
 * «← Volver a mi ruta» si el curso está en la ruta de la persona.
 * En pantallas angostas todo esto se pliega en un botón «Lecciones del curso».
 *
 * La lista se arma al generar el sitio; el navegador solo pinta lo que depende del estado (vistas, barra, ruta,
 * candado sin plan). Para saber si el curso está en la ruta, lee los datos `datos-mi-ruta` que incrusta la página
 * (`lib/catalogo.ts` → `datosMiRutaCompactos`).
 *
 *   <ListaLecciones curso={curso} actual={leccion} numero={3} total={7} escuela="Tecnología" area="Linux" />
 */
import { modulosVisibles, primeraLeccionDisponible, type Curso, type Leccion } from '../../lib/catalogo';
import BarraAvance from '../ui/BarraAvance.astro';

interface Props {
  curso: Curso;
  actual: Leccion;
  numero: number;
  total: number;
  escuela: string;
  area: string | null;
}

const { curso, actual, numero, total, escuela, area } = Astro.props;
const modulos = modulosVisibles(curso);
const variosModulos = modulos.length > 1;
const vistaPrevia = primeraLeccionDisponible(curso);
---

<nav aria-label="Lecciones del curso" data-lista-lecciones data-curso={curso.id}>
  <!-- Solo en pantallas angostas: abre y cierra la lista -->
  <button
    type="button"
    class="flex min-h-12 w-full items-center justify-between gap-3 rounded-cuaderno border-2 border-tinta bg-blanco px-4 text-left font-semibold lg:hidden"
    aria-expanded="false"
    aria-controls="panel-lecciones"
    data-abrir-lecciones
  >
    <span>Lecciones del curso <span class="font-normal text-texto-2">· Lección {numero} de {total}</span></span>
    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 transition-transform in-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M3 6l5 5 5-5" />
    </svg>
  </button>

  <div id="panel-lecciones" class="mt-3 hidden data-abierto:block lg:mt-0 lg:block" data-panel-lecciones>
    <p class="text-sm text-texto-2">{area ? `${escuela} · ${area}` : escuela}</p>
    <p class="mt-1 font-titulo text-2xl leading-tight font-bold">{curso.titulo}</p>
    <p class="mt-4 text-sm text-texto-2">Lección {numero} de {total}</p>
    <BarraAvance valor={0} maximo={total} etiqueta="Lecciones vistas del curso" grosor="delgada" mostrarTexto class="mt-1.5" />

    <div class="mt-5 space-y-4">
      {
        modulos.map((modulo) => (
          <div>
            {variosModulos && <p class="mb-1 text-xs font-semibold tracking-wide text-texto-2 uppercase">{modulo.titulo}</p>}
            <ol class="space-y-0.5">
              {modulo.lecciones.map((leccion) => {
                const esActual = leccion.id === actual.id;
                const requierePlan = leccion.id !== vistaPrevia?.id && !leccion.enPreparacion;
                return (
                  <li class="group" data-leccion={leccion.id} data-estado={esActual ? 'actual' : 'pendiente'}>
                    <a
                      href={`/cursos/${curso.id}/${leccion.slug}`}
                      aria-current={esActual ? 'page' : undefined}
                      class="flex min-h-11 items-start gap-3 rounded-lg px-2 py-2 hover:bg-suave group-data-[estado=actual]:bg-relleno group-data-[estado=actual]:font-semibold"
                    >
                      <span
                        aria-hidden="true"
                        class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border-2 border-tinta bg-blanco text-xs text-blanco group-data-[estado=vista]:bg-tinta"
                      >
                        <span class="hidden group-data-[estado=vista]:inline">✓</span>
                        <span class="hidden size-2 rounded-full bg-tinta group-data-[estado=actual]:inline-block" />
                      </span>
                      <span class:list={['min-w-0 flex-1 leading-snug', leccion.enPreparacion && 'text-texto-2']}>
                        {leccion.titulo}
                        {leccion.enPreparacion && <span class="text-sm"> · en preparación</span>}
                        <span class="sr-only" data-texto-estado>
                          {esActual ? '(lección actual)' : ''}
                        </span>
                      </span>
                      {requierePlan && (
                        <span data-sin-plan class="mt-0.5 shrink-0 text-texto-2" title="Requiere el plan">
                          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2.5" y="7" width="11" height="7.5" rx="1.5" />
                            <path d="M5 7V5a3 3 0 0 1 6 0v2" />
                          </svg>
                          <span class="sr-only">(requiere el plan)</span>
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </div>

    <a
      href={`/cursos/${curso.id}`}
      class="mt-6 inline-flex min-h-11 items-center rounded-cuaderno border-2 border-tinta bg-relleno px-4 text-sm font-semibold hover:shadow-desplazada"
      data-volver
    >
      ← Volver al curso
    </a>
  </div>
</nav>

<script>
  import { pintarBarraAvance } from '../../lib/barra-avance';
  import { leerDatosDePagina } from '../../lib/datos-en-pagina';
  import { alCambiarEstado, leerEstado, type EstadoDemo } from '../../lib/estado-demo';
  import { rutaDelEstado, type DatosMiRuta } from '../../lib/mi-ruta';

  const raiz = document.querySelector<HTMLElement>('[data-lista-lecciones]');
  const datosRuta = leerDatosDePagina<DatosMiRuta>('datos-mi-ruta');

  function pintar(estado: EstadoDemo) {
    if (!raiz) return;
    const vistas = new Set(estado.leccionesVistas);
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-leccion]')];
    for (const fila of filas) {
      const id = fila.dataset.leccion ?? '';
      if (fila.dataset.estado === 'actual') continue;
      fila.dataset.estado = vistas.has(id) ? 'vista' : 'pendiente';
      const texto = fila.querySelector<HTMLElement>('[data-texto-estado]');
      if (texto) texto.textContent = vistas.has(id) ? '(vista)' : '';
    }
    const total = filas.length;
    pintarBarraAvance(raiz.querySelector('[data-barra-avance]'), filas.filter((f) => vistas.has(f.dataset.leccion ?? '')).length, total);

    // «Volver a mi ruta» solo si este curso está en la ruta calculada con el diagnóstico.
    const volver = raiz.querySelector<HTMLAnchorElement>('[data-volver]');
    const enRuta = datosRuta ? rutaDelEstado(estado, datosRuta)?.ruta.cursos.includes(raiz.dataset.curso ?? '') : false;
    if (volver) {
      volver.href = enRuta ? '/mi-ruta' : `/cursos/${raiz.dataset.curso}`;
      volver.textContent = enRuta ? '← Volver a mi ruta' : '← Volver al curso';
    }
  }

  pintar(leerEstado());
  alCambiarEstado(pintar);

  // Desplegable de pantallas angostas.
  const boton = raiz?.querySelector<HTMLButtonElement>('[data-abrir-lecciones]');
  const panel = raiz?.querySelector<HTMLElement>('[data-panel-lecciones]');
  boton?.addEventListener('click', () => {
    const abrir = boton.getAttribute('aria-expanded') !== 'true';
    boton.setAttribute('aria-expanded', String(abrir));
    panel?.toggleAttribute('data-abierto', abrir);
  });
</script>
