---
/**
 * Pantallas 08 · Curso y 09 · Suscripción simulada.
 * Ficha del curso: migas de pan, título, nivel, duración, «Lo que aprenderás», temario y la tarjeta del plan
 * (con su diálogo «Confirmar suscripción», en `components/catalogo/TarjetaPlan.astro`).
 * Se genera una página por curso VISIBLE (los que tienen `oculto: true` no tienen página). Un curso con lecciones de
 * riesgo alto muestra arriba del temario el aviso ético fuerte (`textoAvisoEticoAlto`).
 */
import type { GetStaticPaths } from 'astro';
import {
  areaPrincipalDeCurso,
  cursoTieneRiesgoAlto,
  duracionCurso,
  etiquetaEstadoCurso,
  etiquetaIdiomaDeCurso,
  leccionesVisibles,
  obtenerAjustes,
  obtenerCursosVisibles,
  obtenerEscuela,
  textoEjerciciosCurso,
  type Curso,
} from '../../lib/catalogo';
import { NOMBRES_NIVEL, formatoDuracion, plural } from '../../lib/formato';
import LayoutBase from '../../layouts/LayoutBase.astro';
import ListaTemario from '../../components/catalogo/ListaTemario.astro';
import MigasDePan from '../../components/catalogo/MigasDePan.astro';
import TarjetaPlan from '../../components/catalogo/TarjetaPlan.astro';
import CajaAviso from '../../components/ui/CajaAviso.astro';
import Pildora from '../../components/ui/Pildora.astro';
import Portada from '../../components/ui/Portada.astro';

export const getStaticPaths = (async () => {
  return (await obtenerCursosVisibles()).map((curso) => ({ params: { curso: curso.id }, props: { curso } }));
}) satisfies GetStaticPaths;

interface Props {
  curso: Curso;
}

const { curso } = Astro.props;
const { textoAvisoEtico, textoAvisoEticoAlto } = obtenerAjustes();
const riesgoAlto = cursoTieneRiesgoAlto(curso);

const escuela = await obtenerEscuela(curso.escuela);
const principal = await areaPrincipalDeCurso(curso);
const estado = etiquetaEstadoCurso(curso);
const idioma = etiquetaIdiomaDeCurso(curso);
const numeroLecciones = leccionesVisibles(curso).length;
const proximamente = curso.estado === 'proximamente';

const migas = [
  { texto: 'Escuelas', href: '/escuelas' },
  ...(principal
    ? [
        { texto: principal.area.nombreEscuela, href: `/escuelas#${principal.area.escuela}` },
        { texto: principal.area.nombre, href: principal.tienePagina ? `/areas/${principal.area.id}` : undefined },
      ]
    : []),
];

const datos = [
  NOMBRES_NIVEL[curso.nivel],
  numeroLecciones > 0 ? plural(numeroLecciones, 'lección', 'lecciones') : null,
  formatoDuracion(duracionCurso(curso)),
  await textoEjerciciosCurso(curso),
].filter(Boolean);
---

<LayoutBase titulo={curso.titulo} descripcion={curso.subtitulo}>
  <div class="contenedor grid gap-x-14 gap-y-8 pt-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:pt-10">
    <!-- Encabezado del curso -->
    <div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <MigasDePan tramos={migas} />
        {estado && <Pildora variante={proximamente ? 'suave' : 'normal'}>{estado}</Pildora>}
        {idioma && <Pildora variante="suave">{idioma}</Pildora>}
      </div>
      <h1 class="mt-2 text-4xl sm:text-5xl">{curso.titulo}</h1>
      <p class="mt-3 text-lg">{curso.subtitulo}</p>
      <p class="mt-2 text-sm text-texto-2">{datos.join(' · ')}</p>
    </div>

    <!-- Portada y plan: a la derecha en escritorio; después del encabezado en móvil -->
    <aside aria-label="Plan" class="flex flex-col gap-6 lg:row-span-2">
      <Portada titulo={curso.titulo} escuela={curso.escuela} etiqueta={escuela?.nombre} variante="grande" class="hidden sm:block" />
      <TarjetaPlan curso={curso} class="lg:sticky lg:top-6" />
    </aside>

    <!-- Contenido del curso -->
    <div class="min-w-0 space-y-10">
      {
        curso.avisoEtico && (
          <CajaAviso titulo="Uso ético" tono="atencion">
            {textoAvisoEtico}
          </CajaAviso>
        )
      }

      {
        curso.aprenderas.length > 0 && (
          <section aria-labelledby="titulo-aprenderas">
            <h2 id="titulo-aprenderas" class="text-2xl sm:text-3xl">Lo que aprenderás</h2>
            <ul class="mt-4 space-y-2">
              {curso.aprenderas.map((punto) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-md border-2 border-tinta text-sm font-bold">
                    ✓
                  </span>
                  <span>{punto}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section aria-labelledby="titulo-temario">
        <h2 id="titulo-temario" class="text-2xl sm:text-3xl">Temario</h2>
        {
          riesgoAlto && (
            <CajaAviso titulo="Solo en tu laboratorio" tono="fuerte" class="mt-4">
              {textoAvisoEticoAlto} Las lecciones marcadas con «Solo en tu laboratorio» son de este tipo.
            </CajaAviso>
          )
        }
        <div class="mt-4">
          {
            numeroLecciones > 0 ? (
              <ListaTemario curso={curso} />
            ) : (
              <CajaAviso>Este curso llegará pronto. Por ahora puedes ver su ficha y planear tu ruta con él.</CajaAviso>
            )
          }
        </div>
      </section>
    </div>
  </div>
</LayoutBase>
