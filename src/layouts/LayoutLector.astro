---
/**
 * LayoutLector — el lector de lecciones (pantallas 10 y 11): barra lateral a la izquierda y la lección a la derecha.
 * En pantallas angostas la barra lateral va arriba (y `ListaLecciones` se pliega en un desplegable).
 *
 *   <LayoutLector titulo="Comandos básicos (1 de 2)">
 *     <ListaLecciones slot="lateral" … />
 *     …contenido de la lección…
 *   </LayoutLector>
 *
 * Usa `LayoutBase` (cabecera, pie y avisos). El estilo del texto de la lección (`prose`) está en
 * `src/styles/global.css`, sección 6.
 */
import LayoutBase from './LayoutBase.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion } = Astro.props;
---

<LayoutBase titulo={titulo} descripcion={descripcion}>
  <div class="contenedor grid gap-6 pt-6 lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-14 lg:pt-10">
    <aside class="lg:sticky lg:top-4 lg:max-h-[calc(100dvh-2rem)] lg:self-start lg:overflow-y-auto lg:p-1">
      <slot name="lateral" />
    </aside>
    <div class="min-w-0 max-w-3xl">
      <slot />
    </div>
  </div>
</LayoutBase>
